# Copy to .env for local development. Never commit .env.
# In production, set these as environment variables in your hosting dashboard.

# --- Required ---------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# 32+ random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Optional in development (a temporary one is generated), required in production.
JWT_SECRET=

# --- General ----------------------------------------------------------------
ENVIRONMENT=development          # development | production
GEMINI_MODEL=gemini-3.5-flash
# Frontend URLs allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Accounts ---------------------------------------------------------------
ALLOW_REGISTRATION=true
JWT_EXPIRE_MINUTES=1440
# Optional demo account, created at startup.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# --- Storage & backups ------------------------------------------------------
DATA_DIR=data
BACKUP_DIR=backups
BACKUP_KEEP=7
BACKUP_INTERVAL_HOURS=24         # scheduler runs only when ENVIRONMENT=production

# --- Limits -----------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=500
MAX_DOCUMENTS_PER_USER=20
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_HOUR=10
RATE_LIMIT_AUTH_PER_MINUTE=10
GEMINI_TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=120

# --- RAG & routing ----------------------------------------------------------
RAG_MIN_SCORE=0.6
RAG_TOP_K=5
ROUTER_USE_LLM=true
# Optional cheaper model for the intent classifier (free-tier quota is per model).
ROUTER_MODEL=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true                    # false = readable single-line logs for local dev
