# Copy to .env.local for local development, or set in your hosting dashboard.
# These are baked into the JavaScript bundle at build time - never put secrets here.

# URL of the deployed FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: show a "Try the demo account" button. Use a throwaway account,
# matching DEMO_USER_EMAIL / DEMO_USER_PASSWORD on the backend.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
